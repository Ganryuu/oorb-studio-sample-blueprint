{
  "name": "4-DOF Robot Arm — OORB Blueprint",
  "build": { "dockerfile": "Dockerfile" },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "postCreateCommand": "cd /workspace/ros2_ws && source /opt/ros/jazzy/setup.bash && colcon build --symlink-install",
  "remoteEnv": {
    "ROS_DOMAIN_ID": "0",
    "ROS_LOCALHOST_ONLY": "0"
  },
  "forwardPorts": [9090],
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "redhat.vscode-yaml"]
    }
  }
}
