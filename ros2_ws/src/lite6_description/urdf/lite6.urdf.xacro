<?xml version="1.0"?>
<!--
  UFactory Lite 6 — URDF (derived from MuJoCo Menagerie MJCF)

  6-DOF robot arm. Joint specs, inertials, and link transforms match
  the Menagerie MJCF (sim/models/mjcf/ufactory_lite6/lite6.xml).
  Meshes are STL files from the Menagerie assets directory.

  License: BSD-3-Clause (matches upstream Menagerie model)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lite6">

  <!-- ─── Mesh paths ─── -->
  <xacro:property name="mesh_dir" value="package://lite6_description/meshes"/>

  <!-- ─── Materials ─── -->
  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>
  <material name="silver">
    <color rgba="0.753 0.753 0.753 1"/>
  </material>

  <!-- ─── Base ─── -->
  <link name="base_link">
    <visual>
      <geometry><mesh filename="${mesh_dir}/visual/link_base.stl"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry><mesh filename="${mesh_dir}/collision/link_base.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.00829545 3.26357e-05 0.0631195"/>
      <mass value="1.65394"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.002"/>
    </inertial>
  </link>

  <!-- ─── Joint 1: Base rotation ─── -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.2435" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.28319" upper="6.28319" velocity="3.14" effort="50"/>
  </joint>

  <link name="link1">
    <visual>
      <geometry><mesh filename="${mesh_dir}/visual/link1.stl"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry><mesh filename="${mesh_dir}/collision/link1.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.00036 0.04195 -0.0025" rpy="0 0 0"/>
      <mass value="1.411"/>
      <inertia ixx="0.00145276" ixy="0" ixz="0" iyy="0.00135275" iyz="0" izz="0.000853355"/>
    </inertial>
  </link>

  <!-- ─── Joint 2: Shoulder ─── -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <!-- quat="-1 1 1 1" normalised = 90deg rotations on Y and Z -->
    <origin xyz="0 0 0" rpy="1.5708 0 1.5708"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.61799" upper="2.61799" velocity="3.14" effort="50"/>
  </joint>

  <link name="link2">
    <visual>
      <geometry><mesh filename="${mesh_dir}/visual/link2.stl"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry><mesh filename="${mesh_dir}/collision/link2.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.179 0 0.0584"/>
      <mass value="1.34"/>
      <inertia ixx="0.00560971" ixy="0" ixz="0" iyy="0.0052152" iyz="0" izz="0.00122018"/>
    </inertial>
  </link>

  <!-- ─── Joint 3: Elbow ─── -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.2002 0 0" rpy="-1.5708 0 -1.5708"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.061087" upper="5.23599" velocity="3.14" effort="32"/>
  </joint>

  <link name="link3">
    <visual>
      <geometry><mesh filename="${mesh_dir}/visual/link3.stl"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry><mesh filename="${mesh_dir}/collision/link3.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.072 -0.0357 -0.001"/>
      <mass value="0.953"/>
      <inertia ixx="0.0018521" ixy="0" ixz="0" iyy="0.00175546" iyz="0" izz="0.000703807"/>
    </inertial>
  </link>

  <!-- ─── Joint 4: Wrist 1 ─── -->
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0.087 -0.22761 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.28319" upper="6.28319" velocity="3.14" effort="32"/>
  </joint>

  <link name="link4">
    <visual>
      <geometry><mesh filename="${mesh_dir}/visual/link4.stl"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry><mesh filename="${mesh_dir}/collision/link4.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.002 -0.0285 -0.0813"/>
      <mass value="1.284"/>
      <inertia ixx="0.00370503" ixy="0" ixz="0" iyy="0.00349091" iyz="0" izz="0.00109586"/>
    </inertial>
  </link>

  <!-- ─── Joint 5: Wrist 2 ─── -->
  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.1642" upper="2.1642" velocity="3.14" effort="20"/>
  </joint>

  <link name="link5">
    <visual>
      <geometry><mesh filename="${mesh_dir}/visual/link5.stl"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry><mesh filename="${mesh_dir}/collision/link5.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.01 0.0019"/>
      <mass value="0.804"/>
      <inertia ixx="0.000567553" ixy="0" ixz="0" iyy="0.000529266" iyz="0" izz="0.000507681"/>
    </inertial>
  </link>

  <!-- ─── Joint 6: Wrist 3 (tool flange) ─── -->
  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0 0.0625 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.28319" upper="6.28319" velocity="3.14" effort="20"/>
  </joint>

  <link name="link6">
    <visual>
      <geometry><mesh filename="${mesh_dir}/visual/link6.stl"/></geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry><mesh filename="${mesh_dir}/collision/link6.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 -0.00194 -0.0102"/>
      <mass value="0.13"/>
      <inertia ixx="0.000148148" ixy="0" ixz="0" iyy="8.57757e-05" iyz="0" izz="7.71412e-05"/>
    </inertial>
  </link>

  <!-- ─── Tool flange frame ─── -->
  <joint name="tool_joint" type="fixed">
    <parent link="link6"/>
    <child link="tool_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="tool_link"/>

</robot>
