<?xml version="1.0"?>
<package format="3">
  <name>lite6_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and configs for UFactory Lite 6 sim and hardware profiles</description>
  <maintainer email="blueprints@oorb.io">OORB Studio</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>lite6_description</exec_depend>
  <exec_depend>lite6_control</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
