<mujoco model="Robot Arm">
  <option timestep="0.002" integrator="RK4"/>

  <visual>
    <map force="0.1" zfar="50"/>
    <rgba haze="0.08 0.1 0.12 1"/>
    <global offwidth="1920" offheight="1080" elevation="-25" azimuth="135"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.45 0.55" rgb2="0.05 0.08 0.12" width="512" height="512"/>
    <texture name="floor_tex" type="2d" builtin="checker" width="256" height="256" rgb1="0.18 0.22 0.26" rgb2="0.12 0.15 0.18"/>
    <material name="floor_mat" texture="floor_tex" texrepeat="10 10" reflectance="0.4" shininess="0.6"/>
    <material name="base" rgba="0.3 0.3 0.35 1" shininess="0.8"/>
    <material name="link1" rgba="0.15 0.5 0.85 1" shininess="0.9"/>
    <material name="link2" rgba="0.15 0.65 0.75 1" shininess="0.9"/>
    <material name="link3" rgba="0.2 0.75 0.65 1" shininess="0.9"/>
    <material name="gripper" rgba="0.85 0.35 0.2 1" shininess="0.8"/>
    <material name="joint_mat" rgba="0.6 0.6 0.65 1" shininess="0.95"/>
  </asset>

  <default>
    <joint damping="0.5" armature="0.01"/>
    <geom friction="0.7" margin="0.001"/>
  </default>

  <worldbody>
    <geom name="floor" size="4 4 0.1" type="plane" material="floor_mat"/>

    <light name="key" pos="2 -3 4" dir="-0.5 0.75 -1" diffuse="0.9 0.85 0.8" specular="0.5 0.5 0.5"/>
    <light name="fill" pos="-2 -2 3" dir="0.5 0.5 -0.75" diffuse="0.4 0.45 0.55"/>
    <light name="top" pos="0 0 5" dir="0 0 -1" diffuse="0.3 0.3 0.35"/>

    <body name="base" pos="0 0 0.15">
      <geom name="base_geom" type="cylinder" size="0.25 0.15" material="base"/>

      <body name="shoulder_yaw" pos="0 0 0.15">
        <joint name="joint_base" type="hinge" axis="0 0 1" range="-180 180"/>
        <geom name="shoulder_disk" type="cylinder" size="0.18 0.05" material="joint_mat"/>

        <body name="shoulder" pos="0 0 0.08">
          <geom name="shoulder_mount" type="box" size="0.12 0.08 0.08" material="base"/>

          <body name="upper_arm" pos="0 0 0.08">
            <joint name="joint_shoulder" type="hinge" axis="0 1 0" range="-90 90"/>
            <geom name="upper_arm_geom" type="capsule" fromto="0 0 0 0 0 0.6" size="0.06" material="link1"/>
            <geom name="elbow_joint" type="sphere" pos="0 0 0.6" size="0.08" material="joint_mat"/>

            <body name="forearm" pos="0 0 0.6">
              <joint name="joint_elbow" type="hinge" axis="0 1 0" range="-135 0"/>
              <geom name="forearm_geom" type="capsule" fromto="0 0 0 0 0 0.5" size="0.05" material="link2"/>
              <geom name="wrist_joint" type="sphere" pos="0 0 0.5" size="0.06" material="joint_mat"/>

              <body name="wrist" pos="0 0 0.5">
                <joint name="joint_wrist" type="hinge" axis="0 1 0" range="-90 90"/>
                <geom name="wrist_geom" type="capsule" fromto="0 0 0 0 0 0.2" size="0.04" material="link3"/>

                <body name="gripper" pos="0 0 0.2">
                  <geom name="gripper_base" type="box" size="0.06 0.08 0.03" material="gripper"/>
                  <geom name="finger_left" type="box" pos="0 0.05 0.06" size="0.015 0.01 0.05" material="gripper"/>
                  <geom name="finger_right" type="box" pos="0 -0.05 0.06" size="0.015 0.01 0.05" material="gripper"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- Position actuators with built-in PD control - ctrl is target position in radians -->
    <position name="base_pos" joint="joint_base" kp="100" kv="10" ctrlrange="-3.14159 3.14159"/>
    <position name="shoulder_pos" joint="joint_shoulder" kp="200" kv="20" ctrlrange="-1.5708 1.5708"/>
    <position name="elbow_pos" joint="joint_elbow" kp="150" kv="15" ctrlrange="-2.3562 0"/>
    <position name="wrist_pos" joint="joint_wrist" kp="50" kv="5" ctrlrange="-1.5708 1.5708"/>
  </actuator>

  <keyframe>
    <key name="home" qpos="0 0 0 0"/>
    <key name="extended" qpos="0 45 -45 0"/>
    <key name="folded" qpos="0 60 -120 45"/>
    <key name="demo" qpos="30 30 -60 20"/>
  </keyframe>
</mujoco>
